MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=Date-Project
SHOP_SOURCE_DATABASE=jmh_data_platform

TEMPLATE_DIR=D:\\JMH\\出口业务收汇情况表\\外汇退税\\数据源\\模版
