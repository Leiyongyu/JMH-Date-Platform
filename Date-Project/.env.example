MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=Date-Project
SHOP_SOURCE_DATABASE=jmh_data_platform

TEMPLATE_DIR=D:\\JMH\\出口业务收汇情况表\\外汇退税\\数据源\\模版
EXPORT_OUTPUT_DIR=D:\\JMH\\外汇退税\\Date-Project\\exports
SKU_VALIDATION_FILE=D:\\JMH\\外汇退税\\数据\\SKU核对效验.xlsx
PAYER_NAME=Hong Kong Cammy Yeson Limited

LINGXING_ENDPOINT=https://api.lingxing.com
LINGXING_APP_ID=your_app_id
LINGXING_APP_SECRET=your_app_secret
LINGXING_TOKEN_REFRESH_BEFORE_SEC=300
LINGXING_REQUEST_TIMEOUT_SEC=30
LINGXING_MAX_RETRIES=3
LINGXING_PAGE_SIZE=100
LINGXING_SIGN_KEY=app_id
PYTHON_PERFORMANCE_INTERNAL_TOKEN=replace_with_a_long_random_token
SHOP_SOURCE_DATABASE=jmh_data_platform

# DeepSeek AI assistant (keep the API key only in the Python service)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_SEC=180
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_THINKING_ENABLED=false
# Keep this value on one line when using the built-in .env loader.
DEEPSEEK_SYSTEM_PROMPT=你是JMH数据平台的内部AI助手，请使用简洁准确的中文回答，不得编造ERP业务数据。

# Image SOP (embedded at http://127.0.0.1:8010/image-sop/)
IMAGE_SOP_EXPORT_DIR=
IMAGE_SOP_UPLOAD_DIR=
IMAGE_SOP_WEB_REF_DIR=
IMAGE_SOP_UPLOAD_MAX_FILE_MB=12
IMAGE_SOP_UPLOAD_MAX_TOTAL_MB=40
SOP_GENERATION_MAX_CONCURRENT=1
SOP_IMAGE_COUNT=7
SOP_IMAGE_SIZE=1600*1600
AI_PROVIDER=deepseek
AI_STANDARD_MAX_CONCURRENT=2
AI_PREMIUM_MAX_CONCURRENT=1
AI_TOTAL_MAX_CONCURRENT=2
AI_REQUEST_RETRIES=2
AI_PROFILE_CACHE_TTL_HOURS=72

# eBay Browse API for Image SOP
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Amazon main-image batch upload (Ziniao desktop executor)
# ERP users configure company/account/password/client path in SOP > Script Tools.
# Base port on the Windows execution host. The module uses five slots:
# base port through base port + 4 (default 16851-16855).
AMAZON_IMAGE_UPLOAD_ZINIAO_PORT=16851
# Required fixed shop repository. Each authorized shop is initialized below it.
# Example structure: <root>\<shop-name>__<shop-id-hash>\图片\<SKU>\*.jpg
AMAZON_IMAGE_UPLOAD_SHOP_ROOT=D:\\Amazon主图上传
# Optional local-development fallbacks when bypassing the ERP Java proxy:
AMAZON_IMAGE_UPLOAD_ZINIAO_CLIENT_PATH=C:\\Program Files\\ziniao\\ziniao.exe
AMAZON_IMAGE_UPLOAD_ZINIAO_COMPANY=
AMAZON_IMAGE_UPLOAD_ZINIAO_USERNAME=
AMAZON_IMAGE_UPLOAD_DEFAULT_SHOP=
# Optional; default: Date-Project/outputs/amazon_image_upload
AMAZON_IMAGE_UPLOAD_OUTPUT_DIR=

# Synology NAS image source
NAS_ENABLED=false
NAS_URL=
NAS_USERNAME=
NAS_PASSWORD=
NAS_BASE_PATH=/JMH/供应链中心
NAS_TIMEOUT=30

# Optional web reference image search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ENGINE=baidu
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_CONCURRENT=3
WEB_SEARCH_MAX_IMAGE_SIZE_MB=5
