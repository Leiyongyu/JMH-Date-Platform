LINGXING_APP_ID=your_app_id
LINGXING_APP_SECRET=your_app_secret
LINGXING_TOKEN_REFRESH_BEFORE_SEC=300
LINGXING_REQUEST_TIMEOUT_SEC=30
LINGXING_MAX_RETRIES=3
LINGXING_PAGE_SIZE=100
LINGXING_SIGN_KEY=app_id
# GoodCang V1 storage summary (same credential names as Java; no built-in secrets)
GOODCANG_ENDPOINT=https://oms.goodcang.net/public_open
GOODCANG_APP_TOKEN=
GOODCANG_APP_KEY=
GOODCANG_REQUEST_TIMEOUT_SEC=30
GOODCANG_MIN_REQUEST_INTERVAL_SEC=1.2
GOODCANG_MAX_RETRIES=3
# 飞书开放平台（多维表格只读）。自建应用的凭证，自己填，不要提交到仓库。
# 国际版租户把 FEISHU_ENDPOINT 改成 https://open.larksuite.com
FEISHU_ENDPOINT=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TOKEN_REFRESH_BEFORE_SEC=300
FEISHU_REQUEST_TIMEOUT_SEC=30
FEISHU_MIN_REQUEST_INTERVAL_SEC=0.2
FEISHU_MAX_RETRIES=3
FEISHU_PAGE_SIZE=500
# 卖家级别表，取自表格地址 /base/<app_token>?table=<table_id>&view=<view_id>
FEISHU_SELLER_LEVEL_APP_TOKEN=UjvXbOPJTalrRKsmZKpcUjQ5nEe
FEISHU_SELLER_LEVEL_TABLE_ID=tbl4cDY58uZmiYU1
FEISHU_SELLER_LEVEL_VIEW_ID=vew4MoiWFe
PYTHON_PERFORMANCE_INTERNAL_TOKEN=replace_with_a_long_random_token
SHOP_SOURCE_DATABASE=jmh_data_platform

# DeepSeek AI assistant (keep the API key only in the Python service)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_SEC=180
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_THINKING_ENABLED=false
# Keep this value on one line when using the built-in .env loader.
DEEPSEEK_SYSTEM_PROMPT=你是JMH数据平台的内部AI助手，请使用简洁准确的中文回答，不得编造ERP业务数据。

# Image SOP (embedded at http://127.0.0.1:8010/image-sop/)
IMAGE_SOP_EXPORT_DIR=
IMAGE_SOP_UPLOAD_DIR=
IMAGE_SOP_WEB_REF_DIR=
IMAGE_SOP_UPLOAD_MAX_FILE_MB=12
IMAGE_SOP_UPLOAD_MAX_TOTAL_MB=40
SOP_GENERATION_MAX_CONCURRENT=2
SOP_GENERATION_MAX_CONCURRENT_PER_USER=1
SOP_GENERATION_MAX_QUEUE=20
SOP_IMAGE_COUNT=7
SOP_IMAGE_SIZE=1600*1600
AI_PROVIDER=deepseek
AI_STANDARD_MAX_CONCURRENT=2
AI_PREMIUM_MAX_CONCURRENT=1
AI_TOTAL_MAX_CONCURRENT=2
AI_REQUEST_RETRIES=2
AI_PROFILE_CACHE_TTL_HOURS=72

# eBay Browse API for Image SOP
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Synology NAS image source
NAS_ENABLED=false
NAS_URL=
NAS_USERNAME=
NAS_PASSWORD=
NAS_BASE_PATH=/JMH/供应链中心
NAS_TIMEOUT=30

# Optional web reference image search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ENGINE=baidu
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_CONCURRENT=3
WEB_SEARCH_MAX_IMAGE_SIZE_MB=5
