MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=Date-Project
SHOP_SOURCE_DATABASE=jmh_data_platform
# 迁移专用账号（持有 DDL），仅 python -m backend.cli db-migrate 使用；留空则沿用 MYSQL_USER
MYSQL_MIGRATOR_USER=
MYSQL_MIGRATOR_PASSWORD=
# 启动时自动执行历史建表脚本；生产保持 false
DATABASE_AUTO_MIGRATE=false
# ERP 库迁移脚本目录，默认 ../RuoYi-Vue-springboot3/sql
ERP_SQL_DIR=

TEMPLATE_DIR=D:\\JMH\\出口业务收汇情况表\\外汇退税\\数据源\\模版
EXPORT_OUTPUT_DIR=D:\\JMH\\外汇退税\\Date-Project\\exports
SKU_VALIDATION_FILE=D:\\JMH\\外汇退税\\数据\\SKU核对效验.xlsx
PAYER_NAME=Hong Kong Cammy Yeson Limited

LINGXING_ENDPOINT=https://api.lingxing.com
LINGXING_APP_ID=your_app_id
LINGXING_APP_SECRET=your_app_secret
LINGXING_TOKEN_REFRESH_BEFORE_SEC=300
LINGXING_REQUEST_TIMEOUT_SEC=30
LINGXING_MAX_RETRIES=3
LINGXING_PAGE_SIZE=100
LINGXING_SIGN_KEY=app_id
# GoodCang V1 storage summary (same credential names as Java; no built-in secrets)
GOODCANG_ENDPOINT=https://oms.goodcang.net/public_open
GOODCANG_APP_TOKEN=
GOODCANG_APP_KEY=
GOODCANG_REQUEST_TIMEOUT_SEC=30
GOODCANG_MIN_REQUEST_INTERVAL_SEC=1.2
GOODCANG_MAX_RETRIES=3
# 飞书开放平台（多维表格只读）。自建应用的凭证，自己填，不要提交到仓库。
# 国际版租户把 FEISHU_ENDPOINT 改成 https://open.larksuite.com
FEISHU_ENDPOINT=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TOKEN_REFRESH_BEFORE_SEC=300
FEISHU_REQUEST_TIMEOUT_SEC=30
FEISHU_MIN_REQUEST_INTERVAL_SEC=0.2
FEISHU_MAX_RETRIES=3
FEISHU_PAGE_SIZE=500
# 卖家级别表，取自表格地址 /base/<app_token>?table=<table_id>&view=<view_id>
FEISHU_SELLER_LEVEL_APP_TOKEN=UjvXbOPJTalrRKsmZKpcUjQ5nEe
FEISHU_SELLER_LEVEL_TABLE_ID=tbl4cDY58uZmiYU1
FEISHU_SELLER_LEVEL_VIEW_ID=vew4MoiWFe
# 不良交易刊登表。每周三更新一批；视图筛的是当周那一批，增量同步只拉它。
FEISHU_BAD_TRANSACTION_APP_TOKEN=UjvXbOPJTalrRKsmZKpcUjQ5nEe
FEISHU_BAD_TRANSACTION_TABLE_ID=tbl4j735kfsuqcHl
FEISHU_BAD_TRANSACTION_VIEW_ID=vewohlM1T4
PYTHON_PERFORMANCE_INTERNAL_TOKEN=replace_with_a_long_random_token
SHOP_SOURCE_DATABASE=jmh_data_platform

# DeepSeek AI assistant (keep the API key only in the Python service)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_SEC=180
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_THINKING_ENABLED=false
# Keep this value on one line when using the built-in .env loader.
DEEPSEEK_SYSTEM_PROMPT=你是JMH数据平台的内部AI助手，请使用简洁准确的中文回答，不得编造ERP业务数据。

# Image SOP (embedded at http://127.0.0.1:8010/image-sop/)
IMAGE_SOP_EXPORT_DIR=
IMAGE_SOP_UPLOAD_DIR=
IMAGE_SOP_WEB_REF_DIR=
IMAGE_SOP_UPLOAD_MAX_FILE_MB=12
IMAGE_SOP_UPLOAD_MAX_TOTAL_MB=40
SOP_GENERATION_MAX_CONCURRENT=2
SOP_GENERATION_MAX_CONCURRENT_PER_USER=1
SOP_GENERATION_MAX_QUEUE=20
SOP_IMAGE_COUNT=7
SOP_IMAGE_SIZE=1600*1600
AI_PROVIDER=deepseek
AI_STANDARD_MAX_CONCURRENT=2
AI_PREMIUM_MAX_CONCURRENT=1
AI_TOTAL_MAX_CONCURRENT=2
AI_REQUEST_RETRIES=2
AI_PROFILE_CACHE_TTL_HOURS=72

# eBay Browse API for Image SOP
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Synology NAS image source
NAS_ENABLED=false
NAS_URL=
NAS_USERNAME=
NAS_PASSWORD=
NAS_BASE_PATH=/JMH/供应链中心
NAS_TIMEOUT=30

# Optional web reference image search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ENGINE=baidu
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_CONCURRENT=3
WEB_SEARCH_MAX_IMAGE_SIZE_MB=5

# 定时任务数据质量门禁：warn 只记录告警（默认）/ block 阻断级问题使任务失败并触发告警邮件 / off 关闭
DATA_QUALITY_MODE=warn

# eBay 补货 2.0 规则/备注表所在库；留空=ERP 库（历史位置），迁移后设为 Date-Project
EBAY_REPLENISHMENT_RULE_DATABASE=

# AI 数据助手的模型提供方：dashscope=阿里云百炼（测试），deepseek=DeepSeek（上线）
AI_AGENT_PROVIDER=deepseek
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-max-2026-06-08
# AI 数据助手：专用库（会话/消息/运行记录/调用日志/记忆），由 db-migrate --target agent 自动建库建表
AI_AGENT_DATABASE=jmh_ai_agent
# 思考模式（默认开启，面板可查看思考过程）；思考计入输出 token，故单独设更大的上限
AI_AGENT_THINKING_ENABLED=true
AI_AGENT_MAX_TOKENS=8192
AI_AGENT_MAX_ROUNDS=8
AI_AGENT_MAX_TOOL_CALLS=16
AI_AGENT_TIMEOUT_SEC=300
AI_AGENT_TOOL_TIMEOUT_SEC=90
AI_AGENT_PARALLEL_TOOLS=4
# 按问题难度选择思考：auto=寒暄等无数据意图的短句关闭思考，on=始终思考，off=始终关闭
AI_AGENT_THINKING_MODE=auto
# 简单问题改用的轻量模型（须是当前提供方的模型名，如百炼 qwen-plus）；留空=与主模型相同
AI_AGENT_SIMPLE_MODEL=
# 流式接收：进行中的思考和回答实时写入运行记录，页面逐段显示
AI_AGENT_STREAM=true
# 发给模型的上下文超过该字符数时，较早的工具结果压缩为汇总
AI_AGENT_CONTEXT_CHARS=60000
