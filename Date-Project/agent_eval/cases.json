    {"id": "ebay_live_orders", "sources": ["ebay"], "question": "eBay 最近7天每个店铺的订单数和销售额", "expect_tools": ["ebay_orders_summary"], "forbid_tools": ["performance_ranking"]},
    {"id": "ebay_live_finance", "sources": ["ebay"], "question": "eBay 店铺 DE-Autoteile-Zone 最近7天的广告费、退款和净额是多少？", "expect_tools": ["ebay_finance_summary"]},
