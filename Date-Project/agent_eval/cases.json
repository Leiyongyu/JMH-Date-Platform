    {"id": "inventory", "question": "最新月份库存总货值最高的三个组别是哪些？", "expect_tools": ["monthly_inventory_summary"]},
    {"id": "replenishment", "question": "eBay 补货建议里建议补货量最大的10个SKU", "expect_tools": ["ebay_replenishment"]},
