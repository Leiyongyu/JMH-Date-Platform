<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.operation.external.AmzProductPerformanceInventoryMapper">
    <resultMap type="com.ruoyi.system.domain.operation.external.AmzProductPerformanceInventory" id="Result">
        <id property="id" column="id"/>
        <result property="sid" column="sid"/>
        <result property="sellerSku" column="seller_sku"/>
        <result property="localSku" column="local_sku"/>
        <result property="fbaFulfillable" column="fba_fulfillable"/>
        <result property="fbaTransfer" column="fba_transfer"/>
        <result property="fbaReceiving" column="fba_receiving"/>
        <result property="fbaReserved" column="fba_reserved"/>
        <result property="fbaInbound" column="fba_inbound"/>
        <result property="fbaStock" column="fba_stock"/>
    </resultMap>

    <delete id="deleteAll">DELETE FROM amz_product_performance_inventory</delete>

    <insert id="batchInsert">
        INSERT INTO amz_product_performance_inventory (
            sid, seller_sku, local_sku, fba_fulfillable, fba_transfer,
            fba_receiving, fba_reserved, fba_inbound, fba_stock
        ) VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.sid}, #{e.sellerSku}, #{e.localSku}, #{e.fbaFulfillable}, #{e.fbaTransfer},
             #{e.fbaReceiving}, #{e.fbaReserved}, #{e.fbaInbound}, #{e.fbaStock})
        </foreach>
    </insert>
</mapper>
